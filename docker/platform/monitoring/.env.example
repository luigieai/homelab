# Prometheus retention (metrics)
PROM_RETENTION=30d
PROM_RETENTION_SIZE=8GB

# Grafana bootstrap admin (UI login; change after first login if you want)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Proxmox VE read-only API token (see README.md -> "Proxmox token")
PVE_USER=monitoring@pve
PVE_TOKEN_NAME=pve-exporter
PVE_TOKEN_VALUE=00000000-0000-0000-0000-000000000000

# Grafana / Loki display timezone
TZ=America/Sao_Paulo

# Authentik OIDC for Grafana SSO (create the provider in Authentik; see README.md -> "SSO")
GRAFANA_OIDC_CLIENT_ID=grafana
GRAFANA_OIDC_CLIENT_SECRET=change-me
