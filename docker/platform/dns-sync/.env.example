# Cloudflare API token with Zone:DNS:Edit permission (marioverde.com.br zone)
CLOUDFLARE_API_TOKEN=your-cloudflare-dns-api-token

# Zone ID for marioverde.com.br (Cloudflare dashboard -> domain overview -> API section)
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id

# What created records point at — CNAME target or A record IP.
# Should match whatever docker/platform/ddns keeps the WAN IP-tracking domain set to.
DNS_RECORD_TARGET=lab.marioverde.com.br

# Optional overrides
DNS_RECORD_TYPE=CNAME
DNS_RECORD_PROXIED=false
RECONCILE_INTERVAL_SECONDS=300

# How long a hostname must be continuously absent (no running labeled
# container) before its DNS record is deleted. Guards against wiping public
# DNS on a transient restart/crash-loop. Default 86400 (24h).
DELETE_GRACE_SECONDS=86400

# Image tag to deploy (pushed via scripts/dns-sync/, see its CLAUDE.md)
DNS_SYNC_VERSION=latest
