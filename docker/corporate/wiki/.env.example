# Wiki.js 3 — copy to .env (on the server Komodo writes .env from the stack's Environment settings;
# this file documents the keys and is the only versioned copy — keep secrets out of it).
# Image tag: pin the beta build. Releases: https://github.com/Requarks/wiki/releases
WIKI_VERSION=3.0.0-beta.658

# Lab PostgreSQL (CT 103, internal SDN network)
DB_HOST=10.0.0.2
DB_PORT=5432
DB_NAME=wiki
DB_USER=wikijs
DB_PASS=

# Root administrator, created on the first boot only (no effect once it exists)
ADMIN_EMAIL=
ADMIN_PASS=

# Logging: debug | info | warn | error
LOG_LEVEL=info
