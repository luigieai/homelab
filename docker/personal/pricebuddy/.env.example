# PriceBuddy — copy to .env for a local run. On docker01 Komodo writes .env from the stack's
# Environment settings, so this file only documents the keys and is the only versioned copy.
# Never put a secret in this file.

# Laravel application
# Generate once with: php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'
# Changing it after first boot logs everyone out and breaks anything encrypted at rest.
APP_KEY=
APP_URL=https://price.lab.marioverde.com.br
ASSET_URL=https://price.lab.marioverde.com.br
APP_TIMEZONE=America/Sao_Paulo

# Lab PostgreSQL (CT 103, internal SDN network)
DB_HOST=10.0.0.2
DB_PORT=5432
DB_DATABASE=pricebuddy
DB_USERNAME=pricebuddy
DB_PASSWORD=

# First admin user — honoured only on the very first boot (empty database)
APP_USER_NAME=Luigi
APP_USER_EMAIL=luigi@marioverde.com.br
APP_USER_PASSWORD=

# Stores seeded on first boot. The app only ships australia + usa seed files;
# "all" seeds both. Brazilian stores are added by hand in the UI.
DEFAULT_STORES_COUNTRY=all

# Author affiliate tags on outbound store links (upstream default: true)
AFFILIATE_ENABLED=false
