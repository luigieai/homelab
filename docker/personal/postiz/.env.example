# Postiz — key documentation only. NEVER copy this to .env by hand: Komodo writes
# docker/personal/postiz/.env at deploy time from the stack's Environment settings in Komodo,
# so this file is the versioned contract and the .env is generated state. Keep secrets out of it.
# Image tag: pin the release. Releases: https://github.com/gitroomhq/postiz-app/releases
POSTIZ_VERSION=v2.25.3

# --- URLs (one hostname for UI, API and uploads; split hostnames break OAuth state cookies) ---
MAIN_URL=https://postiz.lab.marioverde.com.br
FRONTEND_URL=https://postiz.lab.marioverde.com.br
NEXT_PUBLIC_BACKEND_URL=https://postiz.lab.marioverde.com.br/api
BACKEND_INTERNAL_URL=http://localhost:3000

# --- Session signing. Rotating it logs everyone out. ---
JWT_SECRET=

# --- In-stack PostgreSQL 17 ---
POSTGRES_USER=postiz-user
POSTGRES_PASSWORD=
POSTGRES_DB=postiz-db-local

# --- Temporal's own PostgreSQL 16 (separate database server, same stack) ---
TEMPORAL_DB_PASSWORD=

# --- Public-API create-post limit per hour (upstream compose ships 30, upstream default is 90) ---
API_LIMIT=90

# --- Provider defaults (only what the lab actually uses; others are unset and hidden in the UI) ---
MASTODON_URL=https://bolha.us

# --- Authentik OIDC. Redirect URI registered on the provider: https://postiz.lab.marioverde.com.br/settings ---
POSTIZ_OAUTH_URL=https://auth.lab.marioverde.com.br
POSTIZ_OAUTH_AUTH_URL=https://auth.lab.marioverde.com.br/application/o/authorize/
POSTIZ_OAUTH_TOKEN_URL=https://auth.lab.marioverde.com.br/application/o/token/
POSTIZ_OAUTH_USERINFO_URL=https://auth.lab.marioverde.com.br/application/o/userinfo/
POSTIZ_OAUTH_CLIENT_ID=
POSTIZ_OAUTH_CLIENT_SECRET=
POSTIZ_OAUTH_SCOPE=openid profile email
NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME=Authentik
NEXT_PUBLIC_POSTIZ_OAUTH_LOGO_URL=https://raw.githubusercontent.com/walkxcode/dashboard-icons/master/png/authentik.png
