# SteamAuth - Docker Environment Configuration
# Copy this file to .env and update the values.
#
# This single file is loaded by both the backend and frontend services
# (see env_file: in compose.yaml) — unused vars per service are harmless.

# =============================================================================
# REQUIRED - You must set these values
# =============================================================================

# Backend JWT signing secret (no safe default — must be set in production)
JWT_SECRET=change-me-to-a-long-random-secret

# Frontend session encryption password (minimum 32 characters)
NUXT_SESSION_PASSWORD=change-me-to-a-random-32-character-minimum-secret

# =============================================================================
# BACKEND
# =============================================================================

# Comma-separated origins allowed to call the backend API
CORS_ORIGINS=https://steamauth.lab.marioverde.com.br

# OIDC / SSO (optional — leave unset to keep local email/password login only)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://steamauth-api.lab.marioverde.com.br/auth/oidc/callback
OIDC_FRONTEND_CALLBACK_URL=https://steamauth.lab.marioverde.com.br/api/auth/oidc/callback

# =============================================================================
# DATA STORAGE
# =============================================================================

# Host path for the backend SQLite database (mounted at /app/data in the container)
DATA_PATH=./data
