# Image tag - set to "dev" for the pre-release build
FGC_TAG=latest

# Active stores - only Steam and Epic Games are enabled
STORES=steam,epic

# --- VNC (manual first-login / 2FA) ---
SHOW=1
WIDTH=1280
HEIGHT=720
NOVNC_PORT=7080
VNC_LOGIN_TIMEOUT=180
# VNC_PASSWORD=changeme

# --- Scheduler ---
SCHEDULER_HOURS=12
SCHEDULER_TIMEZONE=America/Sao_Paulo
RUN_ON_STARTUP=true

# --- Epic Games credentials ---
EG_EMAIL=
EG_PASSWORD=
# EG_OTP_KEY=
EG_MOBILE=false

# --- Steam credentials ---
STEAM_USERNAME=
STEAM_PASSWORD=

# --- Discord notifications only ---
DISCORD_WEBHOOK=
NOTIFY_TEST=false
NOTIFY_SUMMARY=true
NOTIFY_ERRORS=true

# --- Debug ---
DEBUG=true
